generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Product {
  resto
  erp
  web
  soporte
}

enum CourseKind {
  tutorial
  academia
}

enum PaymentSource {
  ingest
  admin
}

enum PaymentStatus {
  pending
  approved
  rejected
}

model Lead {
  id           String      @id @default(cuid())
  name         String
  company      String?
  email        String
  phone        String?
  intent       Product
  message      String?
  createdAt    DateTime    @default(now())
  linkedUserId String?
  linkedUser   ClientUser? @relation(fields: [linkedUserId], references: [id])
}

model ClientUser {
  id             String    @id @default(uuid())
  username       String    @unique
  passwordHash   String
  clientName     String
  /// JSON array de Product, ej. ["resto","web"]
  products       Json      @default("[]")
  active         Boolean   @default(true)
  webServiceUrl  String?
  licenseKey     String    @unique @default(uuid())
  restaurantData Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  leads          Lead[]
  payments       Payment[]
  progress       Progress[]
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        ClientUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String
  amount      Float?
  period      String
  referencia  String?
  receiptPath String
  source      PaymentSource @default(ingest)
  status      PaymentStatus @default(pending)
  reviewedAt  DateTime?
  receivedAt  DateTime      @default(now())

  @@index([userId, referencia])
}

model CourseModule {
  id         String     @id @default(cuid())
  product    Product
  kind       CourseKind
  title      String
  youtubeUrl String
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  progress   Progress[]
}

model Progress {
  id        String       @id @default(cuid())
  userId    String
  moduleId  String
  completed Boolean      @default(false)
  updatedAt DateTime     @updatedAt
  user      ClientUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}
